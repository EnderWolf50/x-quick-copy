{
  "manifest_version": 3,
  "name": "X Quick Copy",
  "version": "8.6.0",
  "description": "Ctrl+C on X copies the hovered image, video/GIF URL, or a FixupX link. Double-click a tweet to toggle Like.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://cdn.syndication.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
